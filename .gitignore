# Build trees. `rake compile` builds under tmp/ and stages the extension in
# lib/, `rake build` drops the gem in pkg/
/tmp/
/pkg/
*.gem
*.o
*.so
/lib/disjoint_interval_tree/.build-id
*.bundle

# `ruby extconf.rb` run in place, rather than through rake, leaves these
# behind. Do NOT ignore `Makefile` unqualified: that pattern matches at any
# depth and would silently exclude `test/c/Makefile`, which is a source file
/ext/**/Makefile
/ext/**/mkmf.log

# C test binaries
/test/c/test_dit_debug
/test/c/test_dit_asan
/test/c/test_dit_release
